   CC = gcc
   CFLAGS = -Wall -g
   
   charcnt: utils.o charcnt.o
       $(CC) $(CFLAGS) utils.o charcnt.o -o charcnt
  
   charcnt.o: charcnt.c utils.h
       $(CC) $(CFLAGS) -c  charcnt.c -o charcnt.o
   
   utils.o: utils.c utils.h
      $(CC) $(CFLAGS) -c  utils.c -o utils.o
  
  clean: 
      rm -f charcnt charcnt.o utils.o
                                         
